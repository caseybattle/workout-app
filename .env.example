# OpenAI key used server-side only (app/api/ai/route.js) — never exposed to the browser.
OPENAI_API_KEY=

# Google OAuth client, from Google Cloud Console > APIs & Services > Credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random string NextAuth uses to sign session tokens. Not tied to any external account.
AUTH_SECRET=

# Comma-separated list of emails allowed to sign in. Leave empty to allow any Google account.
ALLOWED_EMAILS=

# Neon Postgres connection string (Vercel's Neon integration sets this automatically).
DATABASE_URL=

# Optional. USDA FoodData Central key for /api/foods — falls back to a shared demo key if unset.
USDA_API_KEY=

# Optional. Max AI calls per user per day. Defaults to 40 if unset.
AI_DAILY_LIMIT=40
